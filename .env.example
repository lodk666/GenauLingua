# ---- Telegram bot ----
BOT_TOKEN=your-telegram-bot-token
ADMIN_USER=your-telegram-user-id

# ---- PostgreSQL ----
POSTGRES_USER=genau_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genaulingua_db

# Async driver (used by the bot), sync driver (used by Alembic)
DATABASE_URL=postgresql+asyncpg://genau_user:${POSTGRES_PASSWORD}@postgres:5432/genaulingua_db
DATABASE_URL_SYNC=postgresql://genau_user:${POSTGRES_PASSWORD}@postgres:5432/genaulingua_db

# ---- Optional infra ----
ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs
SENTRY_DSN=
